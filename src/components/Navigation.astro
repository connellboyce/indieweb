---
import NavItem from './NavItem.astro';

const navValues = [
    { displayText: 'home', href: '/' },
    { displayText: 'blog', href: '/blog' },
    { displayText: 'projects', href: '/projects' },
    { displayText: 'links', href: '/links' },
    { displayText: 'webcafe', href: '/webcafe' }
];
---
<section class="grid grid-flow-col auto-cols-fr gap-4 py-4">
    {
        navValues.map((value, key) => (
            <NavItem key={key} displayText={value.displayText} href={value.href} />
        ))
    }
</section>
